{
  "name": "crownline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:data",
    "dev": "vite",
    "pretest": "npm run generate:data",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "generate:data": "node --import tsx scripts/generate-data.ts",
    "precheck:fonts": "npm run generate:data",
    "check:fonts": "bash scripts/font-venv.sh scripts/check-font-subset.py",
    "preregen:fonts": "npm run generate:data",
    "regen:fonts": "bash scripts/font-venv.sh scripts/regen-font-subsets.py",
    "prebuild": "npm run generate:data",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
