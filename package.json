{
  "name": "crownline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:data",
    "dev": "vite",
    "pretest": "npm run generate:data",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "generate:data": "node --import tsx scripts/generate-data.ts",
    "check:docs": "node --import tsx scripts/check-data-docs.ts",
    "precheck:fonts": "npm run generate:data",
    "check:fonts": "bash scripts/font-venv.sh scripts/check-font-subset.py",
    "preregen:fonts": "npm run generate:data",
    "regen:fonts": "bash scripts/font-venv.sh scripts/regen-font-subsets.py",
    "prebuild": "npm run generate:data",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "setup:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "precheck": "npm run generate:data",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run validate:data && npm run check:docs --ignore-scripts && npm run check:fonts --ignore-scripts && npm run test:coverage --ignore-scripts && npm run build --ignore-scripts && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
