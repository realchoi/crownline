      "names": {
        "primary": "补罗稽舍二世",
        "aliases": [
          "Pulakesi II",
          "Pulakeshin II"
        ]
      },
      "description": "补罗稽舍二世，西遮娄其王朝主要君主序列中的统治人物。他是遮娄其最伟大的君主之一，曾北征击败北印度旃陀罗设赏伽（戒日王），并将势力扩展至德干广大区域；其治下艾荷莱、巴达米等地的石窟寺亦颇具盛名。",
      "sourceRefs": [
        {
          "sourceId": "source-chalukya-history"
        },
        {
          "sourceId": "source-chalukya-rulers"
        }
      ]
    },
    {
      "id": "person-chalukya-vikramaditya-i",
      "names": {
        "primary": "超日王一世",
        "aliases": [
          "Vikramaditya I",
          "Vikramaditya I Chalukya"
        ]
      },
      "description": "超日王一世，西遮娄其王朝主要君主序列中的统治人物。他在642—655年间的王位空位或争位期后恢复遮娄其统治，并重新整合王朝势力。",
      "sourceRefs": [
        {
          "sourceId": "source-chalukya-history"
        },
        {
          "sourceId": "source-chalukya-rulers"
        }
      ]
    },
